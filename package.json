{
  "name": "metabolic-score-studio",
  "version": "1.0.0",
  "description": "High-resolution Remotion motion composition for metabolic risk awareness",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "audio": "python3 scripts/make_audio.py",
    "build": "remotion render src/index.ts MetabolicMaster out/metabolic-master.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "build:4k": "remotion render src/index.ts MetabolicMaster out/metabolic-master-4k.mp4 --width=3840 --height=2160 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/media": "4.0.545",
    "@remotion/transitions": "4.0.545",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.7.2"
  }
}
